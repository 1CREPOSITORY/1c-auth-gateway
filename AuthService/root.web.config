<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="true">
        <add name="AuthServiceModule" type="AuthService.AuthModule" />
      </modules>
    </system.webServer>
  </location>
</configuration>
